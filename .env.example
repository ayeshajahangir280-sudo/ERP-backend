DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

DATABASE_URL=postgresql://username:password@internal-postgres-host:5432/database_name

CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://your-frontend.vercel.app

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
TIME_ZONE=Asia/Dubai

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
